{
  "name": "blive-vod-desktop",
  "version": "2.99.0",
  "private": true,
  "description": "B站直播弹幕点歌机桌面端（Electron + Clash 风格 UI）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qdlinux.blivevod",
    "productName": "blive-vod",
    "directories": {
      "output": "../package-exe/dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../package-exe/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "blive-vod-desktop-${version}.exe",
      "unpackDirName": "blive-vod-desktop"
    },
    "compression": "maximum"
  }
}
